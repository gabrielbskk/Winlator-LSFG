# Local Android SDK/NDK and Gradle caches
/.android-sdk/
/.gradle-build-cache/

# Local IDE and build state
**/.gradle/
**/.cxx/
**/build/
local.properties

# Generated packages and temporary runtime files
*.apk
*.aab
*.apks
*.log
**/__pycache__/
*.py[cod]

# Private/local LSFG analysis inputs and extracted shader dumps
**/Lossless.dll
**/*.spv
**/*.spvasm
**/*reflection*.json

# Codespace-only references, SDKs, reports and staging files
/lab/
/.reference/
/winlator-lsfg/
CLOUDFLARE_LOGIN_URL.txt

# Machine-specific editor and OS files (shared IDE settings are retained)
*.iml
.DS_Store
Thumbs.db
