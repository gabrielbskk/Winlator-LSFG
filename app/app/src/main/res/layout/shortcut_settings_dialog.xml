<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/LLContent"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/name" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                style="@style/EditText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:id="@+id/ETName"
                android:inputType="textCapSentences" />

            <ImageButton
                style="@style/ListMenuButton"
                android:id="@+id/BTNameMenu"
                android:src="@drawable/icon_menu" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_size" />

                <Spinner
                    style="@style/ComboBox"
                    android:layout_width="match_parent"
                    android:id="@+id/SScreenSize"
                    android:entries="@array/screen_size_entries" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LLCustomScreenSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/width" />

                    <EditText
                        style="@style/EditText"
                        android:layout_width="78dp"
                        android:id="@+id/ETScreenWidth"
                        android:inputType="number" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="18dp"
                    android:layout_gravity="bottom"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_marginBottom="4dp"
                    android:text="x" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/height" />

                    <EditText
                        style="@style/EditText"
                        android:layout_width="78dp"
                        android:id="@+id/ETScreenHeight"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/graphics_driver" />

        <LinearLayout
            android:id="@+id/LLGraphicsDriver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dxwrapper" />

            <ImageView
                android:id="@+id/BTHelpDXWrapper"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginLeft="4dp"
                android:src="@drawable/icon_help"
                app:tint="#e0e0e0" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LLDXWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_driver" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                style="@style/ComboBox"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:id="@+id/SAudioDriver"
                android:entries="@array/audio_driver_entries" />

            <ImageButton
                style="@style/ListMenuButton"
                android:id="@+id/BTAudioDriverConfig"
                android:src="@drawable/icon_audio_settings" />
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/TabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/tab_layout_background"
            app:tabTextColor="?attr/tabTextColor"
            app:tabGravity="center"
            app:tabMode="auto">

            <com.google.android.material.tabs.TabItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/win_components" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/environment_variables" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recovery" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/advanced" />
        </com.google.android.material.tabs.TabLayout>

        <LinearLayout
            android:id="@+id/LLTabWinComponents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    style="@style/FieldSet"
                    android:id="@+id/LLWinComponentsDirectX" />

                <TextView
                    style="@style/FieldSetLabel"
                    android:background="?attr/colorSecondarySurface"
                    android:text="@string/directx" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    style="@style/FieldSet"
                    android:id="@+id/LLWinComponentsGeneral" />

                <TextView
                    style="@style/FieldSetLabel"
                    android:background="?attr/colorSecondarySurface"
                    android:text="@string/general" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LLTabEnvVars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.winlator.widget.EnvVarsView
                android:id="@+id/EnvVarsView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"/>

            <View style="@style/HorizontalLine" />

            <Button
                style="@style/ButtonNeutral"
                android:id="@+id/BTAddEnvVar"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/add" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LLTabRecovery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                style="@style/ButtonNeutral"
                android:id="@+id/BTRestorePreviousConfiguration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_previous_configuration" />

            <Button
                style="@style/ButtonNeutral"
                android:id="@+id/BTSaveWorkingConfiguration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save_working_configuration" />

            <Button
                style="@style/ButtonNeutral"
                android:id="@+id/BTApplyWorkingConfiguration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/apply_working_configuration" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LLTabAdvanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/box64_preset" />

                    <Spinner
                        style="@style/ComboBox"
                        android:id="@+id/SBox64Preset"
                        android:layout_width="match_parent" />
                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:background="?attr/colorSecondarySurface"
                    android:text="@string/box64" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile" />

                    <Spinner
                        style="@style/ComboBox"
                        android:id="@+id/SControlsProfile"
                        android:layout_width="match_parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/directinput_mapper_type" />

                    <Spinner
                        style="@style/ComboBox"
                        android:id="@+id/SDInputMapperType"
                        android:layout_width="match_parent"
                        android:entries="@array/dinput_mapper_type_entries" />
                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:background="?attr/colorSecondarySurface"
                    android:text="@string/input_controls" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exec_arguments" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            style="@style/EditText"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:id="@+id/ETExecArgs" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:id="@+id/BTExtraArgsMenu"
                            android:src="@drawable/icon_menu" />
                    </LinearLayout>

                    <!-- The icon preview is extracted locally. Only a user-approved
                         Discord asset key / public HTTPS URL reaches Discord. -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/discord_game_artwork_title" />

                    <ImageView
                        android:id="@+id/IVDiscordExeIconPreview"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginTop="4dp"
                        android:layout_gravity="center_horizontal"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/discord_exe_icon_preview" />

                    <Button
                        style="@style/ButtonNeutral"
                        android:id="@+id/BTShareDiscordExeIcon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/discord_share_exe_icon" />

                    <EditText
                        style="@style/EditText"
                        android:id="@+id/ETDiscordArtwork"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:maxLength="300"
                        android:singleLine="true"
                        android:hint="@string/discord_game_artwork_hint" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/discord_game_artwork_help" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/discord_steam_id_title" />

                    <EditText
                        style="@style/EditText"
                        android:id="@+id/ETDiscordSteamId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:inputType="textUri"
                        android:maxLength="140"
                        android:hint="@string/discord_steam_id_hint" />

                    <Button
                        style="@style/ButtonNeutral"
                        android:id="@+id/BTDetectSteamId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/discord_steam_detect_local" />

                    <Button
                        style="@style/ButtonNeutral"
                        android:id="@+id/BTSearchSteamName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/discord_steam_search_name" />

                    <TextView
                        android:id="@+id/TVSteamIdSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/discord_steam_help" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/discord_rpc_example_title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:background="?attr/colorSecondarySurface">

                        <ImageView
                            android:id="@+id/IVDiscordRpcPreviewArtwork"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:scaleType="centerCrop"
                            android:contentDescription="@string/discord_rpc_example_artwork" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingLeft="12dp">

                            <TextView
                                android:id="@+id/TVDiscordRpcPreviewGame"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:maxLines="2" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/discord_rpc_example_playing" />

                            <TextView
                                android:id="@+id/TVDiscordRpcPreviewMeta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="3"
                                android:text="@string/discord_rpc_example_default" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/discord_rpc_example_disclaimer" />

                    <CheckBox
                        android:id="@+id/CBForceFullscreen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/force_fullscreen"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:background="?attr/colorSecondarySurface"
                    android:text="@string/system" />
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
